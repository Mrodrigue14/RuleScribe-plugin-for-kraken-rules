// Rules of the Policy namespace, referenced from policy-entrypoints.rules
// (Ctrl+click on the names there must land HERE).
Namespace Policy

Rule "Policy code mandatory" On Policy.policyCd {
    Set Mandatory
    Error "policy_cd" : "The policy code is mandatory"
}

// Two dimensional variants of the SAME name, which is legitimate in Kraken (each
// @Dimension selects its own at runtime). Ctrl+click on "Postal code default"
// from an EntryPoint must therefore offer BOTH, each popup line showing its
// annotation, since the file alone would not tell them apart.
@Dimension("state", "CA")
Rule "Postal code default" On AddressInfo.postalCode {
    Reset To "90210"
}

@Dimension("state", "NY")
Rule "Postal code default" On AddressInfo.postalCode {
    Reset To "10001"
}

Rule "Effective date past" On Policy.effectiveDate {
    Description "The effective date must be in the past"
    When Policy.policyCd != null
    Assert effectiveDate < Today()
    Error "eff_date" : "The date must be in the past"
    Overridable
}

// Function calls: Round is native and TotalLimit is declared in
// policy-functions.rules; "Rnd" does not exist and neither does "Round" with 3
// arguments, so neither of those resolves.
Rule "Total limit is rounded" On Policy.policyCd {
    Assert Round(TotalLimit(Policy.Coverage), 2) > 0
    Error "total_limit" : "The total limit must be positive"
}

Rule "Broken function calls demo" On Policy.policyCd {
    Assert Rnd(1.5) > 0 and Round(1.5, 2, 3) > 0
}
