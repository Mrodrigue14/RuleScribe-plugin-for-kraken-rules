// Functions of the Policy namespace.
//
// Kraken resolves a call against three sources, in increasing order of
// precedence (see the engine's ScopeBuilder): native Java functions, a
// Function with a KEL body, a Function without a body. A function is
// identified by its NAME and PARAMETER COUNT, never by types.
//
// To try here:
//  - Ctrl+Space in a rule body → natives + project functions
//  - Ctrl+Q on "Round" elsewhere → docs, examples and version from the engine
//  - Ctrl+Q on "TotalLimit" → the comment below
//  - Ctrl+P inside a call's parentheses → the available signatures
//  - Ctrl+B on "TotalLimit" from policy-rules.rules → lands here
//  - natives and project functions have two distinct colours
Namespace Policy

/**
 * Sum of the limits of all the policy's coverages.
 * @since 1.0.0
 * @parameter coverages - the coverages to add up
 * @example TotalLimit(Policy.Coverage)
 * @result 3000
 */
Function TotalLimit(Coverage[] coverages) : Number {
    Sum(coverages.limitAmount)
}

// Without a body: declares that a registered Java implementation exists. The
// engine fails the project build otherwise.
Function ResolvePlanCd(PackageDetails) : String
