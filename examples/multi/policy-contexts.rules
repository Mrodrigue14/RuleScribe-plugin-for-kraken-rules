// Contexts and dimensions of the Policy namespace.
// "Include Base" makes the rules of the Base namespace visible here.
Namespace Policy

Include Base

Root Context Policy Is BaseEntity {
    String policyCd
    String state
    Date effectiveDate
    Child AddressInfo
    Child* Coverage
}

// Multiple cardinality (Child*): Policy.Coverage denotes a collection, which
// TotalLimit expects in policy-functions.rules.
Context Coverage {
    Money limitAmount
}

Context AddressInfo {
    String postalCode
    String state
}

Dimension "state" : String
Dimension "plan" : String
