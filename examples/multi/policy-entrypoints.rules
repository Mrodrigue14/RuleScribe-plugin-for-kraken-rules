// EntryPoints of the Policy namespace, in a file SEPARATE from the rules.
// To try here:
//  - Ctrl+click on each name → jumps to policy-rules.rules or base.rules
//  - Ctrl+Space inside the braces → offers the visible rules
//  - "Does not exist" → underlined by the inspection (unknown rule)
//  - "Hidden elsewhere" → underlined too: the Other namespace is not included
//
// Navigation in BOTH directions (see also policy-rules.rules):
//  - item → implementation: "Postal code default" has two @Dimension
//    variants → popup with 2 entries, each showing its annotation;
//  - implementation → EntryPoints: Ctrl+click on a rule name in
//    policy-rules.rules / base.rules lists the EntryPoints citing it;
//    "Policy code mandatory" and "Base sanity check" have two each.
Namespace Policy

EntryPoint "Validation" {
    "Policy code mandatory",
    "Effective date past",
    "Base sanity check"
}

EntryPoint "Defaults" {
    "Postal code default",
    EntryPoint "Validation"
}

// A second citation of two rules already referenced by "Validation": this is what
// makes the implementation → EntryPoint direction interesting (popup, not a jump).
EntryPoint "Quick check" {
    "Policy code mandatory",
    "Base sanity check"
}

EntryPoint "Broken references demo" {
    "Does not exist",
    "Hidden elsewhere"
}
