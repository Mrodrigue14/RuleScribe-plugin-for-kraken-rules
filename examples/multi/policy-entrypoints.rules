// EntryPoints du namespace Policy, dans un fichier SÉPARÉ des règles.
// À tester ici :
//  - Ctrl+clic sur chaque nom → saute vers policy-rules.rules ou base.rules
//  - Ctrl+Espace dans les accolades → propose les règles visibles
//  - "Je n'existe pas" → souligné par l'inspection (règle inconnue)
//  - "Hidden elsewhere" → souligné aussi : le namespace Other n'est pas inclus
//
// Navigation dans les DEUX sens (voir aussi policy-rules.rules) :
//  - item → implémentation : "Postal code default" a deux variantes
//    @Dimension → popup à 2 entrées, annotation affichée sur chacune ;
//  - implémentation → EntryPoints : Ctrl+clic sur le nom d'une règle dans
//    policy-rules.rules / base.rules liste les EntryPoints qui la citent —
//    "Policy code mandatory" et "Base sanity check" en ont deux chacun.
Namespace Policy

EntryPoint "Validation" {
    "Policy code mandatory",
    "Effective date past",
    "Base sanity check"
}

EntryPoint "Defaults" {
    "Postal code default",
    EntryPoint "Validation"
}

// Deuxième citation de deux règles déjà référencées par "Validation" : c'est ce
// qui rend le sens implémentation → EntryPoint intéressant (popup, pas saut direct).
EntryPoint "Quick check" {
    "Policy code mandatory",
    "Base sanity check"
}

EntryPoint "Broken references demo" {
    "Je n'existe pas",
    "Hidden elsewhere"
}
