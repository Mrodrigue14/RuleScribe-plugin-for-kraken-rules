// Demo file for the Kraken Rules plugin.
// Open it with the plugin installed to see highlighting, completion
// (Ctrl+Space), inspections and navigation (Ctrl+B).

Namespace Policy

/**
 * Root context of the policy.
 */
Root Context Policy {
    String policyCd
    String state
    Child AddressInfo
}

Context AddressInfo {
    String postalCode
    String state
}

Dimension "state" : String

@Dimension("state", "CA")
Rule "Set AddressInfo.postalCode to state name" On AddressInfo.postalCode {
    Reset To "CA"
}

Rule "Policy code is mandatory" On Policy.policyCd {
    Set Mandatory
    Error "policy_cd_mandatory": "The policy code is mandatory"
}

Rule "Effective date in the past" On Policy.effectiveDate {
    Description "The effective date must be in the past"
    Priority 10
    When Policy
    Assert effectiveDate < Today()
    Error "date_code" : "The date must be in the past"
    Overridable
}

// Ctrl+B on the names below navigates to the rules.
// An unknown reference is underlined by the inspection.
EntryPoint "Validation" {
    "Policy code is mandatory",
    "Effective date in the past"
}

// Without this EntryPoint, the rule "Set AddressInfo..." would be reported as
// "not referenced": a rule that is never listed is never evaluated.
EntryPoint "Defaults" {
    "Set AddressInfo.postalCode to state name"
}
