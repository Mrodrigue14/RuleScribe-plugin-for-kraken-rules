      "since": null,
      "examples": [
        {
          "expression": "All({true, false})",
          "result": "false"
        },
        {
          "expression": "All({true, true})",
          "result": "true"
        },
        {
          "expression": "All({false, false})",
          "result": "false"
        },
        {
          "expression": "All({null})",
          "result": "false"
        },
        {
          "expression": "All({})",
          "result": "false"
        },
        {
          "expression": "All(Policy.riskItems[*].isPrimary)",
          "result": null
