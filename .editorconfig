# Kotlin style, read by both ktlint and IntelliJ.
#
# `intellij_idea` rather than `ktlint_official`: this code is written in
# IntelliJ, and the IDE's own style is what the editor produces by itself.
# Measured on the codebase before reformatting, ktlint_official required 1970
# fixes, android_studio 1093 and intellij_idea 745.
[*.{kt,kts}]
ktlint_code_style = intellij_idea
